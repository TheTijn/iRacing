{
  "name": "instant-racing",
  "version": "1.0.0",
  "description": "Instant Horse & Greyhound Racing - mobile-first instant betting game",
  "main": "server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "start": "ng build && node server.js",
    "serve": "node server.js",
    "test": "ng test --watch=false",
    "races": "node scripts/build-races.mjs",
    "telemetry:dogs": "node scripts/derive-dog-telemetry.mjs",
    "transcode": "bash scripts/transcode.sh"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "bootstrap": "^5.3.8",
    "express": "^4.21.0",
    "gsap": "^3.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
